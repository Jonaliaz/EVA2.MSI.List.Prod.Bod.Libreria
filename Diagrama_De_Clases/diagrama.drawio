  <diagram name="Página-1" id="MHANuEA69WZ6HZp2DbBv">
    <mxGraphModel dx="2580" dy="1410" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% Módulo de Catálogo\n    class Editorial {\n        -idEditorial: int\n        -nombre: String\n    }\n\n    class Autor {\n        -idAutor: int\n        -nombreCompleto: String\n    }\n\n    class Producto {\n        -idProducto: int\n        -titulo: String\n        +registrar(): void\n        +editar(): void\n    }\n\n    class Libro\n    class Revista\n    class Enciclopedia\n\n    %% Módulo de Inventario y Bodegas\n    class Bodega {\n        -idBodega: int\n        -nombre: String\n        -ubicacion: String\n        +crearBodega(): void\n        +editarBodega(): void\n        +consultarBodega(): Bodega\n    }\n\n    class StockBodega {\n        -cantidad: int\n        +actualizarStock(cantidad: int): void\n        +consultarStock(): int\n    }\n\n    %% Módulo de Movimientos\n    class Movimiento {\n        -idMovimiento: int\n        -fecha: Date\n        -cantidad: int\n        +registrarTraslado(): void\n        +obtenerDetalle(): String\n    }\n\n    %% Módulo de Seguridad y Usuarios\n    class Usuario {\n        -idUsuario: int\n        -nombre: String\n        -username: String\n        -password: String\n        +iniciarSesion(): boolean\n        +cerrarSesion(): void\n    }\n\n    class JefeBodega {\n        +gestionarBodegas(): void\n        +generarInformes(): void\n        +autorizarMovimiento(): void\n    }\n\n    class Bodeguero {\n        +registrarMovimiento(): void\n    }\n\n    class SistemaAutenticacion {\n        +autenticarUsuario(username: String, password: String): boolean\n        +autorizarUsuario(usuario: Usuario, permiso: String): boolean\n    }\n\n    %% Módulo de Informes\n    class Informe {\n        +generarPorBodega(bodega: Bodega): PDF\n        +generarPorEditorial(editorial: String): PDF\n        +generarPorTipoProducto(tipo: String): PDF\n        +generarInformeMovimientos(): PDF\n    }\n\n    %% Herencia\n    Producto &lt;|-- Libro\n    Producto &lt;|-- Revista\n    Producto &lt;|-- Enciclopedia\n    Usuario &lt;|-- JefeBodega\n    Usuario &lt;|-- Bodeguero\n\n    %% Relaciones de Catálogo\n    Editorial \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Producto : publica\n    Producto \&quot;1..*\&quot; --&gt; \&quot;1..*\&quot; Autor : escrito_por\n\n    %% Relaciones de Inventario\n    Bodega \&quot;1\&quot; o-- \&quot;0..*\&quot; StockBodega : contiene\n    StockBodega \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Producto : referencia_a\n\n    %% Relaciones de Traslados\n    Movimiento \&quot;*\&quot; --&gt; \&quot;1\&quot; Bodega : bodega_origen\n    Movimiento \&quot;*\&quot; --&gt; \&quot;1\&quot; Bodega : bodega_destino\n    Movimiento \&quot;*\&quot; --&gt; \&quot;1\&quot; Producto : traslada\n\n    %% Relaciones de Roles y Acciones\n    JefeBodega \&quot;1\&quot; --&gt; \&quot;*\&quot; Movimiento : autoriza\n    Bodeguero \&quot;1\&quot; --&gt; \&quot;*\&quot; Movimiento : registra\n    JefeBodega \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Informe : genera\n\n    %% Relaciones de Seguridad\n    Usuario \&quot;*\&quot; --&gt; \&quot;1\&quot; SistemaAutenticacion : usa&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="oGDdFLGowDB1fpOhy_pI-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
